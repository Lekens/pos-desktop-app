# POS Desktop App — Environment Variables
# Copy this file to .env and fill in the values

NODE_ENV=development

# ── Backend API URL ───────────────────────────────────────────────────────────
# URL of the POS-backend-v2 API (no /api/v1 suffix — Axios appends it at runtime).
# Development: local NestJS server
# LAN deployment: http://192.168.1.100:3003
# Cloud deployment: https://api.yourstore.com
ELECTRON_BACKEND_URL=http://localhost:3003

# ── Kiosk mode ────────────────────────────────────────────────────────────────
# Locks the app to full-screen and prevents taskbar/dock access.
# Set to true for dedicated cashier terminals.
ELECTRON_KIOSK_MODE=false

# ── Auto-update server ────────────────────────────────────────────────────────
# Leave blank during development.
# GitHub Releases: configured in electron-builder.yml (not here).
# Self-hosted: https://updates.yourstore.com
ELECTRON_UPDATE_URL=
